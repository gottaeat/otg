# vim: set ft=sh:

umask 022

# - - path - - #
append_path(){
    case ":$PATH:" in
        *:"$1":*)
        ;;
        *)
            PATH="${PATH:+$PATH:}$1"
        ;;
    esac
}

{% if platform == "Linux" %}
PATH="{{ prefix }}/bin:${PATH}"
append_path '/usr/local/sbin'
append_path '/usr/local/bin'
append_path '/usr/bin'
{% elif platform == "Darwin" %}
if [ -x "/usr/libexec/path_helper" ]; then
    eval `/usr/libexec/path_helper -s`
    PATH="{{ prefix }}/bin:${PATH}"
fi
{% endif %}
export PATH

# - - don't expose - - #
unset TERMCAP

# - - bash specific - - #
if [ ! -z "${BASH}" ]; then
    # - - profile.d - - #
    if [ -d "/etc/profile.d" ]; then
        for i in /etc/profile.d/*.sh; do
            [ -r "${i}" ] && . "${i}"
        done

        unset i
    fi

    # - - prompts - - #
    _PS1_BASE=" \$? \[\033[1;37m\]\W\[\033[1;31m\]:\[\e[m\] "

    if [ $(id -u) -eq 0 ]
        then
            PS1="\[\033[1;34m\]${_PS1_BASE}"
        else
            PS1="\[\033[1;30m\]${_PS1_BASE}"
    fi

    PS2=" \[\033[1;37m\]>\[\e[m\] "

    # - - git-prompt.sh - - #
    . {{ prefix }}/share/git-prompt.sh
    PS1="\$(__git_ps1 '\[\e[30;43m\] %s \[\e[m\]')${PS1}"

    export PS1 PS2
    unset _PS1_BASE

    # - - history - - #
    shopt -s histappend

    PROMPT_COMMAND="history -a; history -c; history -r"
    HISTSIZE=1000
fi

unset append_path

# - - essential - - #
export LANG="en_US.UTF-8"
export PAGER="less"
export EDITOR="vim"
export GPG_TTY="$(tty)"

{% if platform == "Darwin" %}
# - - brew - - #
eval "$(/opt/homebrew/bin/brew shellenv)"

for bindir in "/opt/homebrew/opt/"*"/libexec/gnubin"; do
    export PATH="${bindir}:${PATH}"
done

for mandir in "/opt/homebrew/opt/"*"/libexec/gnuman"; do
    export MANPATH="${mandir}:${MANPATH}"
done
{% endif %}

# - - tooling - - #
MAKEFLAGS="${MAKEFLAGS} -j$(nproc)"
CPPFLAGS="-DNDEBUG -D_FORTIFY_SOURCE=2"
CFLAGS="${CPPFLAGS} -g0 -s -w -pipe -O3"
CFLAGS="${CFLAGS} -fcommon -fstack-protector-strong"
CXXFLAGS="${CFLAGS}"
{% if platform == "Linux" %}
export LDFLAGS="${CFLAGS} -Wl,--as-needed,--sort-common,-z,relro,-z,now,--gc-sections,-O3"
{% endif %}
export MAKEFLAGS CPPFLAGS CFLAGS CXXFLAGS

# - - aliases - - #
_LS_PATH="$(which ls)"
alias l="${_LS_PATH} -AFHhp --color=auto --group-directories-first"
alias ll="${_LS_PATH} -AFHhp --color=auto --group-directories-first -w1"
alias lll="${_LS_PATH} -AFHhp --color=auto --group-directories-first -l"
alias ls="${_LS_PATH} -AFHhp --color=auto --group-directories-first"
alias grep="grep --color=auto"
alias cdg="cd {{ stuff_prefix }}/techy-bits/git"
alias cdl="cd {{ stuff_prefix }}/media/lewd"
alias cds="cd {{ stuff_prefix }}"
alias cdw="cd {{ stuff_prefix }}/techy-bits/work"
alias cdt1="cd {{ stuff_prefix }}/techy-bits/work/table"
alias cdt2="cd {{ stuff_prefix }}/techy-bits/work/table2"
alias cdt3="cd {{ stuff_prefix }}/techy-bits/work/table3"
alias cdt4="cd {{ stuff_prefix }}/techy-bits/work/table4"
alias cdt5="cd {{ stuff_prefix }}/techy-bits/work/table5"
alias tmux="tmux -2"
alias gs="git status -s"
alias gcd1="git clone --depth=1 --recursive --shallow-submodules"
alias cp="cp -v"
alias ln="ln -v"
alias mv="mv -v"
alias mkdir="mkdir -pv"
alias mount="mount -v"
unset _LS_PATH
